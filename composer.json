{
    "name": "jayanta/laravel-natural-query",
    "description": "Privacy-safe natural language to SQL engine for Laravel. AI sees only your schema, never your data. Supports voice & text input with pluggable AI providers (Gemini, OpenAI, Claude, Ollama).",
    "keywords": ["laravel", "natural-language", "sql", "ai", "voice", "text-to-sql", "privacy", "database", "query", "gemini", "openai", "claude"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Jay Anta",
            "email": "jay123anta@gmail.com",
            "homepage": "https://github.com/jay123anta"
        }
    ],
    "homepage": "https://github.com/jay123anta/laravel-natural-query",
    "support": {
        "issues": "https://github.com/jay123anta/laravel-natural-query/issues",
        "source": "https://github.com/jay123anta/laravel-natural-query"
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/cache": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.15.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5|^12.0|^13.0",
        "orchestra/testbench": "^10.0|^11.0"
    },
    "suggest": {
        "jayanta/laravel-ai-guard": "Adds scoring-based prompt-injection, jailbreak and bot detection to the built-in input guard. Auto-detected — no wiring required."
    },
    "autoload": {
        "psr-4": {
            "Jayanta\\NaturalQuery\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jayanta\\NaturalQuery\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jayanta\\NaturalQuery\\NaturalQueryServiceProvider"
            ],
            "aliases": {
                "NaturalQuery": "Jayanta\\NaturalQuery\\Facades\\NaturalQuery"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
