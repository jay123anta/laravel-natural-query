<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <!--
            Accuracy benchmark. Self-skips unless NATURALQUERY_BENCHMARK=1,
            because it makes real API calls — a suite that quietly spends money
            on every run is a bad neighbour.
        -->
        <testsuite name="Benchmark">
            <directory>tests/Benchmark</directory>
        </testsuite>
    </testsuites>
</phpunit>
